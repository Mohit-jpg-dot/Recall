{
  "manifest_version": 3,
  "name": "Recall — Web Memory",
  "version": "0.1.0",
  "description": "Remember everything you discover online. Recall turns your browsing into a private, searchable memory.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
