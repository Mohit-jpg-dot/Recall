# ─────────────────────────────────────────────────────────────────────────────
# Recall — Environment Variables Specification
# Copy this file to .env (or .env.production) and fill in genuine credentials.
# NEVER commit .env files containing production secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Logging ─────────────────────────────────────────────────────
ENVIRONMENT=development              # "development" or "production"
LOG_LEVEL=INFO                       # "DEBUG", "INFO", "WARNING", "ERROR"

# ── Database (PostgreSQL 16 + pgvector) ───────────────────────────────────────
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall_dev_password
POSTGRES_DB=recall
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async connection string used by SQLAlchemy:
DATABASE_URL=postgresql+asyncpg://recall:recall_dev_password@localhost:5432/recall

# ── Redis (Queue, Caching & Rate Limiting) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Generate a secure 32-byte secret: `openssl rand -hex 32`
JWT_SECRET=change-this-in-production-to-a-cryptographically-secure-random-token
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. In production, specify exact domains:
# e.g., "https://recall.yourdomain.com,https://app.yourdomain.com"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting (Requests per 60-second window per IP) ─────────────────────
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PAIR=15
RATE_LIMIT_BATCH=120

# ── AI Providers (RAG Chat & Embeddings) ──────────────────────────────────────
# OpenAI (recommended for semantic search & RAG citations)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Note: If OPENAI_API_KEY is omitted, Recall automatically activates its
# deterministic local 1536-dimensional hash embedding engine and grounded citation
# fallback generator without crashing.

# ── Frontend & Extensions ─────────────────────────────────────────────────────
# Web application build-time API pointer:
VITE_API_URL=http://localhost:8000
