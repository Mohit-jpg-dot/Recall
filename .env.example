# ─────────────────────────────────────────────
# Recall — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall_dev_password
POSTGRES_DB=recall
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://recall:recall_dev_password@localhost:5432/recall

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret-key
API_CORS_ORIGINS=http://localhost:5173

# ── JWT ───────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-different-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Providers ──────────────────────────────
# OpenAI (default provider)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Anthropic (alternative)
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514

# Local/Ollama (alternative)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.1

# ── Provider Selection ────────────────────────
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# ── Extension ─────────────────────────────────
VITE_API_URL=http://localhost:8000
